# LotCheck backend configuration example. Replace placeholders in your deployment secret store.
# This file contains no credentials and must never be used as production configuration.
NODE_ENV=development
HOST=0.0.0.0
PORT=4000

# PostgreSQL connection URL; local values are examples only.
DATABASE_URL=postgresql://lotcheck:change-me@127.0.0.1:5432/lotcheck
DB_POOL_MAX=10
DB_SSL=disable
DB_AUTO_MIGRATE=false

# Private document storage. Local storage is intended only for development.
STORAGE_DRIVER=local
STORAGE_DIR=./storage/private
MAX_UPLOAD_BYTES=10485760
MAX_EXTRACTED_TEXT_CHARS=30000
MAX_PACKAGE_BYTES=80000

# Object storage configuration is required when STORAGE_DRIVER=s3.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_SERVER_SIDE_ENCRYPTION=AES256

POLICY_VERSION=lotcheck-document-review-v1

# Local development may use AUTH_MODE=disabled. Production requires a verified OIDC provider.
AUTH_MODE=disabled
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_REQUIRED_ROLE=lotcheck:reviewer
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Keep the checked-in example disabled; live settings and the signer belong in the runtime secret/config store.
GENLAYER_MODE=disabled
GENLAYER_NETWORK=testnetBradbury
GENLAYER_RPC=https://rpc-bradbury.genlayer.com
GENLAYER_CONTRACT_ADDRESS=
GENLAYER_PRIVATE_KEY=
GENLAYER_EXPLORER_URL=
GENLAYER_POLL_INTERVAL_MS=5000
GENLAYER_JOB_INTERVAL_MS=3000
GENLAYER_JOB_MAX_ATTEMPTS=8
GENLAYER_MAX_ROTATIONS=3
